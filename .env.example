# Environment Variables
PROJECT_NAME="EduTrack AI - Autonomous Attendance & Voice CRM"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edutrack_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/edutrack_db

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT Broker (EMQX or Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=edutrack_backend
MQTT_PASSWORD=secret_mqtt_pass

# Security & JWT
SECRET_KEY=generate_a_very_secure_random_key_here_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Voice Pipeline & APIs
GROQ_API_KEY=gsk_your_groq_lpu_api_key_here
MOHIR_AI_API_KEY=your_mohir_ai_token_here
MOHIR_AI_TTS_WS_URL=wss://api.mohir.ai/v1/tts/stream
MOHIR_AI_STT_URL=https://api.mohir.ai/v1/stt

# Asterisk PBX / SIP Trunk
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_ARI_USER=asterisk
ASTERISK_ARI_PASS=asterisk123

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFyourTelegramBotToken
TELEGRAM_DIRECTOR_ALERTS_CHAT_ID=-1001234567890

# Payment Gateways (Uzbekistan)
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret
PAYME_MERCHANT_ID=your_payme_id
PAYME_SECRET_KEY=your_payme_secret
